# Copy to .env.production and replace every placeholder. Protect the file (chmod 600).
DOOR_ENV=production
DOOR_API_KEY=REPLACE_WITH_UNIQUE_RANDOM_64_HEX_CHARACTERS
DOOR_PUBLIC_API_HOSTNAME=monban-api.shionkk.f5.si
DOOR_ALLOWED_HOSTS=monban-api.shionkk.f5.si,127.0.0.1,localhost
DOOR_ALLOW_TAILNET_HTTP=0

# Private LiveKit control/media bridge. Public audio clients use /api/relay over WSS.
LIVEKIT_URL=http://livekit:7880
LIVEKIT_WS_URL=ws://livekit:7880
DOOR_RELAY_LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_UNIQUE_LIVEKIT_SECRET
LIVEKIT_AGENT_NAME=door-voice-agent

# Modal endpoint URLs and bearer tokens; keep these values in the deployment secret file only.
DOOR_OLLAMA_BASE_URL=https://REPLACE_WITH_MODAL_LLM_ENDPOINT
DOOR_LLM_API_KEY=REPLACE_WITH_MODAL_LLM_TOKEN
DOOR_LLM_MODEL=monban-reception-v20-e4b-qlora-q4km:20261109
DOOR_LLM_MAX_TOKENS=96
DOOR_LLM_TIMEOUT_SECONDS=150
DOOR_INFERENCE_ON_DEMAND=1
DOOR_ASR_BASE_URL=https://REPLACE_WITH_MODAL_ASR_ENDPOINT
DOOR_ASR_API_KEY=REPLACE_WITH_MODAL_ASR_TOKEN
DOOR_ASR_API_MODEL=kotoba-tech/kotoba-whisper-v2.1
DOOR_TTS_BASE_URL=https://REPLACE_WITH_MODAL_TTS_ENDPOINT
DOOR_TTS_API_KEY=REPLACE_WITH_MODAL_TTS_TOKEN
DOOR_TTS_API_MODEL=irodori-tts-mf
DOOR_TTS_VOICE=none
DOOR_TTS_SAMPLE_RATE=48000
DOOR_TTS_SEED=11
DOOR_TTS_INSTRUCTIONS=落ち着いた穏やかな口調で、感情を強調せず、自然で丁寧に読み上げてください。
DOOR_WARMUP=1
DOOR_WARMUP_TIMEOUT_SECONDS=90

# Supabase owns accounts, homes/shops, reservations, Google Calendar and visit history.
# Only the project URL and the publishable/anon key; never a secret/service-role key.
DOOR_SUPABASE_URL=https://bqdvxzvezecunnkbcyoy.supabase.co
DOOR_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
DOOR_HOUSE_SETTINGS_TIMEOUT_SECONDS=1.5
DOOR_VISIT_WRITE_TIMEOUT_SECONDS=3
DOOR_RESERVATION_TIMEOUT_SECONDS=5

DOOR_CALENDAR_CACHE_SECONDS=30
DOOR_MAX_CONCURRENT_REQUESTS=4
DOOR_MAX_QUEUED_REQUESTS=8
DOOR_QUEUE_WAIT_SECONDS=2
DOOR_MAX_API_REQUEST_BYTES=16384
DOOR_MAX_TTS_RESPONSE_BYTES=5242880
DOOR_MAX_RELAY_SESSIONS=4
DOOR_RELAY_START_TIMEOUT_SECONDS=5
DOOR_RELAY_MAX_SESSION_SECONDS=120
DOOR_TURN_DETECTOR=vad
LOG_LEVEL=INFO
