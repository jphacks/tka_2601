# Local development only. Generate unique production credentials in your secret manager.
DOOR_ENV=development
DOOR_API_KEY=
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_WS_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
DOOR_LIVEKIT_TRUSTED_HTTP_HOSTS=
LIVEKIT_AGENT_NAME=door-voice-agent
DOOR_UI_HOSTNAME=door-ui.shionkk.f5.si
DOOR_ALLOWED_HOSTS=localhost,127.0.0.1,door-ui.shionkk.f5.si

# Locally hosted inference services.
DOOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
DOOR_LLM_MODEL=gemma4:latest
DOOR_ASR_BASE_URL=http://127.0.0.1:18095
DOOR_ASR_API_MODEL=kotoba-tech/kotoba-whisper-v2.1
DOOR_TTS_BASE_URL=http://127.0.0.1:18094
DOOR_TTS_API_MODEL=Irodori-TTS-v4.1-Small-MF
DOOR_TTS_VOICE=door_neutral
DOOR_TTS_SAMPLE_RATE=48000
DOOR_TTS_SEED=11
DOOR_TTS_INSTRUCTIONS=落ち着いた穏やかな口調で、感情を強調せず、自然で丁寧に読み上げてください。
DOOR_HOUSE_RULES=宅配ボックスを優先し、入らない場合は玄関前に置いてください。荷物と置き場所の写真を撮ってください。
DOOR_MAX_HOUSE_RULES_CHARS=800
DOOR_MAX_TTS_RESPONSE_BYTES=5242880
DOOR_API_REQUESTS_PER_MINUTE=120
DOOR_MAX_CONCURRENT_REQUESTS=4
DOOR_MAX_QUEUED_REQUESTS=8
DOOR_QUEUE_WAIT_SECONDS=2
DOOR_MAX_API_REQUEST_BYTES=16384
DOOR_TURN_DETECTOR=vad

# PSoC 6 relay (/api/relay)
DOOR_SUPABASE_URL=
DOOR_HOUSE_SETTINGS_TIMEOUT_SECONDS=1
DOOR_MAX_RELAY_SESSIONS=4
DOOR_RELAY_START_TIMEOUT_SECONDS=5
DOOR_RELAY_MAX_SESSION_SECONDS=120

LOG_LEVEL=INFO
