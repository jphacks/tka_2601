# API connection settings for this XIAO project.
# Copy to .env, fill in the server's API key, then run:
#   python3 configure_api.py
#   bash run.sh upload <port>
# Hostname only: no https://, port or path. HTTPS/443 and /api/status are used.
DOOR_UI_HOSTNAME=door-ui.shionkk.f5.si
# Same Bearer token as the server (32-511 characters).
DOOR_API_KEY=
# Default mode until the app's mode is first fetched (then the last fetched mode is kept in NVS).
# normal, omakase, or away. Stop mode is set in the app, not here.
DOOR_RELAY_MODE=omakase
# Device key issued for resident settings / visit history (different from API key).
# Required for voice calls; leave blank only when checking /api/status.
DOOR_DEVICE_KEY=

# App-to-XIAO pusher settings. Configure the matching root CA with configure_device.py.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
