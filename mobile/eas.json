{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_FEATURE_GOOGLE_CALENDAR": "1",
        "EXPO_PUBLIC_FEATURE_HOTPEPPER": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6829702081"
      }
    }
  }
}
