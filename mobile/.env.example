# Supabase のプロジェクトの URL と publishable key（sb_publishable_...）。secret key は入れない
EXPO_PUBLIC_SUPABASE_URL=https://bqdvxzvezecunnkbcyoy.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 1 にすると画面に出す。クラウドに設定があるときだけ有効にする
EXPO_PUBLIC_FEATURE_ASSISTANT=
EXPO_PUBLIC_FEATURE_EXTERNAL_PROVIDERS=
EXPO_PUBLIC_FEATURE_RECEPTION=
EXPO_PUBLIC_FEATURE_SOCIAL_LOGIN=

# Google カレンダーは既定で表示。0 にすると非表示
EXPO_PUBLIC_FEATURE_GOOGLE_CALENDAR=1
# ホットペッパービューティーは既定で非表示。再開時に 1 にする
EXPO_PUBLIC_FEATURE_HOTPEPPER=0
