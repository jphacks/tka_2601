# 通知の Edge Function（push）のシークレット。supabase/functions/.env に写して値を入れる（コミットしない）
# クラウドでは supabase secrets set --env-file で設定する
# Expo のアクセストークン（Enhanced Security for Push Notifications を有効にした場合に要る）
EXPO_ACCESS_TOKEN=
# Database Webhook の合言葉。Vault の push_webhook_secret と同じ値にする（openssl rand -hex 32 など）
PUSH_WEBHOOK_SECRET=
# Google カレンダーの接続（Edge Function の reservations と calendar-sync）。4つそろわないと接続できない
# Google Cloud の OAuth クライアント（ウェブアプリ）。承認済みのリダイレクト URI に <RESERVATIONS_PUBLIC_URL>/google/callback を登録する
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# reservations 関数の公開 URL。例: https://<project-ref>.supabase.co/functions/v1/reservations
RESERVATIONS_PUBLIC_URL=
# 更新トークンを暗号化する鍵（openssl rand -base64 32）
CALENDAR_TOKEN_KEY=
# Square の接続（Edge Function の reservations）。RESERVATIONS_PUBLIC_URL と CALENDAR_TOKEN_KEY も要る
# Square Developer Console のアプリの Application ID と Application secret
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# production か sandbox。空なら production
SQUARE_ENVIRONMENT=sandbox
# Webhook の署名鍵。Webhook の通知先は <RESERVATIONS_PUBLIC_URL>/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
# 自然言語の入力（Edge Function の assistant）。BASE_URL がなければ 503 を返し、アプリは入力フォームへ案内する
# 解析器（Ollama）の URL。ローカルの Mac の Ollama なら http://host.docker.internal:11434
ASSISTANT_LLM_BASE_URL=
# モデル名。空なら gemma4:latest
ASSISTANT_LLM_MODEL=
# 接続先が認証を求めるときの Bearer トークン（任意）
ASSISTANT_LLM_API_KEY=
# 待つ時間（ミリ秒）。空なら 20000
ASSISTANT_LLM_TIMEOUT_MS=
