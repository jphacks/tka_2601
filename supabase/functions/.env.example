# 通知の Edge Function（push）のシークレット。supabase/functions/.env に写して値を入れる（コミットしない）
# クラウドでは supabase secrets set --env-file で設定する
# Expo のアクセストークン（Enhanced Security for Push Notifications を有効にした場合に要る）
EXPO_ACCESS_TOKEN=
# Database Webhook の合言葉。Vault の push_webhook_secret と同じ値にする（openssl rand -hex 32 など）
PUSH_WEBHOOK_SECRET=
